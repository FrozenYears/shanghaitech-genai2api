# ShanghaiTech GenAI proxy configuration
GENAI_TOKEN=student_id@password
PORT=31100
API_FORMAT=both
# API_KEY=local-proxy
# 完全空完成的额外继续次数（0禁用，最多30）。
GENAI_EMPTY_CONTINUATIONS=8
# 正常结束且未交付正文/思考/调用的坏工具批次，允许模型重新生成（0禁用，最多10）。
GENAI_TOOL_REPAIR_ATTEMPTS=3
# 首次、空继续、协议纠错共用总窗口，不由心跳或新一代续期。
GENAI_TOOL_REQUEST_TIMEOUT_SECONDS=900
